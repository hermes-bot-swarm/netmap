[Unit]
Description=netmap ingest API + public map
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/opc/netmap/server/ingest.py --port 80 --db /home/opc/var/lib/netmap/netmap.db
WorkingDirectory=/home/opc/netmap
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
